:root :where(.wp-block-post-title){font-family: var(--wp--preset--font-family--avenir-next-world-regular);font-size: var(--wp--custom--typography--font-size--gigantic);font-weight: 300;line-height: var(--wp--custom--typography--line-height--tiny);}
